# Este é um arquivo de exemplo.
# Renomeie este arquivo para ".env" na raiz do seu projeto
# e adicione sua chave de API do Google Maps.

# Chave para o app.config.js (Nativo)
GOOGLE_MAPS_API_KEY="SUA_CHAVE_DE_API_VAI_AQUI"

# Chaves do Google
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY="SUA_CHAVE_DE_API_VAI_AQUI"
EXPO_PUBLIC_GOOGLE_GEOCODING_API_KEY="SUA_CHAVE_DE_API_VAI_AQUI"

# Chaves para o Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSySuaChaveAqui...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef