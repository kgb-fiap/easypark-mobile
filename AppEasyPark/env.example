# Este é um arquivo de exemplo.
# Renomeie este arquivo para ".env" na raiz do seu projeto
# e adicione sua chave de API do Google Maps.

# Chave para o app.config.js (Nativo)
GOOGLE_MAPS_API_KEY="SUA_CHAVE_DE_API_VAI_AQUI"

# Chaves para usar no código React
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY="SUA_CHAVE_DE_API_VAI_AQUI"
EXPO_PUBLIC_GOOGLE_GEOCODING_API_KEY="SUA_CHAVE_DE_API_VAI_AQUI"